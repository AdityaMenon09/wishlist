# Postgres connection string. Leave unset locally to use the embedded database in ./.data
# On Vercel: Storage -> Create -> Neon (free). It sets DATABASE_URL for you.
DATABASE_URL=

# Password for the site. Required in production; unset locally = no login.
APP_PASSWORD=

# Any long random string. Vercel sends it to the daily price-check cron job.
CRON_SECRET=

# Optional. Free SerpApi key (serpapi.com) enables real prices from other stores.
# Without it, the Compare panel shows search links to trusted stores instead.
SERPAPI_KEY=
